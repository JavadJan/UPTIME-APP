# Postgres credentials used by the db and backend services.
POSTGRES_USER=uptime
POSTGRES_PASSWORD=uptime
POSTGRES_DB=uptime

# The frontend origin allowed by the NestJS backend's CORS config.
FRONTEND_URL=http://localhost:3001

# Baked into the frontend's browser bundle at build time - see the comment
# in docker-compose.yml before changing this.
NEXT_PUBLIC_API_URL=http://localhost:3000

# JWT signing secret used by the backend auth module.
JWT_SECRET=dev-jwt-secret-change-me
