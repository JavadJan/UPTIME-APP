// This now targets Postgres, matching the "db" service in docker-compose.yml.
// If you ever want to go back to zero-setup local SQLite (e.g. for quick
// experiments without Docker), change provider back to "sqlite" and point
// DATABASE_URL at a file, e.g. "file:./dev.db" - nothing else changes.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password   String    @default("")
  createdAt DateTime  @default(now())
}

model Monitor {
  id            String        @id @default(uuid())
  name          String
  url           String
  intervalSecs  Int           @default(60)
  timeoutMs     Int           @default(5000)
  isActive      Boolean       @default(true)
  lastStatus    String        @default("UNKNOWN")
  lastCheckedAt DateTime?
  createdAt     DateTime      @default(now())
  userId        String        @default("00000000-0000-0000-0000-000000000001")
  checks        CheckResult[]
  alerts        AlertLog[]
}

model CheckResult {
  id           String        @id @default(uuid())
  monitorId    String
  monitor      Monitor       @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  status       String
  statusCode   Int?
  responseMs   Int?
  errorMessage String?
  checkedAt    DateTime      @default(now())

  @@index([monitorId, checkedAt])
}

model AlertLog {
  id          String   @id @default(uuid())
  monitorId   String
  monitor     Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  fromStatus  String
  toStatus    String
  sentAt      DateTime @default(now())
}
