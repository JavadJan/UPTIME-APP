# If running via the root docker-compose setup, DATABASE_URL is already
# set for you in that environment - you don't need this file for that path.
#
# For standalone use (no Docker), point this at any Postgres instance,
# e.g. one started with: docker run -p 5433:5432 -e POSTGRES_PASSWORD=uptime postgres:16-alpine
DATABASE_URL="postgresql://postgres:uptime@localhost:5433/uptime_monitor"

PORT=3000
